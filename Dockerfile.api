# Must be 3.12+, not 3.11 — api.py uses state.py's Location (a plain
# typing.TypedDict) as a Pydantic v2 field type, which raises
# PydanticUserError on Python < 3.12 ("use typing_extensions.TypedDict
# instead"). Confirmed by an actual failed Cloud Run deploy on 3.11-slim.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# api.py's actual dependency graph — orchestrate.py pulls in the two
# subgraphs, oia_subgraph pulls in oia_parser, and orchestrate.py itself
# reuses test_router_model.py's prompt/parsing constants (see its
# module docstring) rather than duplicating them.
COPY state.py oia_parser.py hazard_subgraph.py oia_subgraph.py \
     checkpoint_cleanup.py test_router_model.py orchestrate.py api.py ./

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT}"]
